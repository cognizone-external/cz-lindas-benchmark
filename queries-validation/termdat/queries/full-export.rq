#pragma push.filters aggressive

PREFIX schema: <http://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX termdat: <https://register.ld.admin.ch/termdat/>

SELECT ?collection ?collectionNameDe ?collectionNameFr ?collectionNameIt ?sub ?nameDe ?nameFr ?nameIt ?abbvrDe ?abbvrFr ?abbvrIt ?descriptionDe ?descriptionFr ?descriptionIt ?citationDe ?citationFr ?citationIt ?synonymDe ?synonymFr ?synonymIt WHERE {

    VALUES ?collection {termdat:LUFT24}

    ?sub schema:inDefinedTermSet ?collection .

    ?collection schema:name ?collectionNameDe.
    FILTER(lang(?collectionNameDe) = "de")
    ?collection schema:name ?collectionNameFr.
    FILTER(lang(?collectionNameFr) = "fr")
    ?collection schema:name ?collectionNameIt.
    FILTER(lang(?collectionNameIt) = "it")


    ?sub schema:name ?nameDe.
    FILTER(lang(?nameDe) = "de")
    ?sub schema:name ?nameFr.
    FILTER(lang(?nameFr) = "fr")
    ?sub schema:name ?nameIt.
    FILTER(lang(?nameIt) = "it")

    OPTIONAL { ?sub schema:description ?descriptionDe.
               FILTER(lang(?descriptionDe) = "de")}
    OPTIONAL { ?sub schema:description ?descriptionFr.
               FILTER(lang(?descriptionFr) = "fr")}
    OPTIONAL { ?sub schema:description ?descriptionIt.
               FILTER(lang(?descriptionIt) = "it")  }

    OPTIONAL {?sub schema:citation ?citationDe.
              FILTER(lang(?citationDe) = "de")}
    OPTIONAL { ?sub schema:citation ?citationFr.
               FILTER(lang(?citationFr) = "fr")}
    OPTIONAL {  ?sub schema:citation ?citationIt.
                FILTER(lang(?citationIt) = "it")   }

    OPTIONAL {?sub schema:alternateName ?abbrvDe.
              FILTER(lang(?abbrvDe) = "de") }
    OPTIONAL {?sub schema:alternateName ?abbrvFr.
              FILTER(lang(?abbrvFr) = "fr")}
    OPTIONAL {?sub schema:alternateName ?abbrvIt.
              FILTER(lang(?abbrvIt) = "it")}

    OPTIONAL {
        SELECT ?sub (group_concat(?sDe; separator=", ") as ?synonymDe) WHERE {
            ?sub schema:hasPart ?part.
            ?part a <https://schema.ld.admin.ch/Synonym>.
            ?part schema:name ?sDe.
            FILTER(lang(?sDe) = "de")
        } GROUP BY ?sub
    }

    OPTIONAL {
        SELECT ?sub (group_concat(?sFr; separator=", ") as ?synonymFr) WHERE {
            ?sub schema:hasPart ?part.
            ?part a <https://schema.ld.admin.ch/Synonym>.
            ?part schema:name ?sFr.
            FILTER(lang(?sFr) = "fr")
        } GROUP BY ?sub
    }

    OPTIONAL {
        SELECT ?sub (group_concat(?sIt; separator=", ") as ?synonymIt) WHERE {
            ?sub schema:hasPart ?part.
            ?part a <https://schema.ld.admin.ch/Synonym>.
            ?part schema:name ?sIt.
            FILTER(lang(?sIt) = "it")
        } GROUP BY ?sub
    }


}

LIMIT 1000